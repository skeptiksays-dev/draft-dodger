{
  "name": "draft-dodger",
  "productName": "Draft Dodger",
  "version": "0.8.0",
  "description": "DoTA Draft Dodger: live Dota 2 counter picks with the game link built in.",
  "main": "main.js",
  "author": "SkeptiK",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.draftdodger",
    "productName": "Draft Dodger",
    "copyright": "Fan-made. Not affiliated with Valve Corporation.",
    "files": ["main.js", "preload.js", "gsi.js", "app/**/*", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "DraftDodger-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Draft Dodger",
      "deleteAppDataOnUninstall": false
    },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
